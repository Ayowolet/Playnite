# Playnite Python Service Configuration

# Server Configuration
HOST=127.0.0.1
PORT=5555
RELOAD=false

# Database Configuration
DATABASE_URL=sqlite:///./data/playnite_python.db

# Capture Configuration
CAPTURE_BASE_PATH=~/Playnite/Captures
DEFAULT_SCREENSHOT_HOTKEY=f8
DEFAULT_VIDEO_HOTKEY=f9
DEFAULT_INSTANT_REPLAY_SECONDS=30
DEFAULT_VIDEO_QUALITY=high
DEFAULT_CAPTURE_BACKEND=direct

# Recommendation Configuration
RECOMMENDATION_LIMIT_DEFAULT=10
MIN_PLAYTIME_FOR_PREFERENCE_SECONDS=3600
SIMILARITY_THRESHOLD=0.3

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=./data/logs/playnite_python.log

# Cache Configuration
CACHE_ENABLED=true
CACHE_TTL_SECONDS=3600

# Security Configuration
API_KEY=change-this-to-a-secure-random-key
JWT_SECRET_KEY=change-this-to-a-secure-random-string-min-32-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
ENABLE_API_KEY_AUTH=true

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000
RATE_LIMIT_ENABLED=true

# Monitoring
ENABLE_METRICS=true
METRICS_PORT=9090

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:*,http://127.0.0.1:*
